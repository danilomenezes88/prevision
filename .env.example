# Configuração de Provedores de LLM
# Escolha o provedor padrão: openai | gemini | anthropic | ollama | groq
LLM_PROVIDER=openai

# Chaves de API (preencha a do provedor que for utilizar)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Configuração para Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Parâmetros Padrão de Simulação
DEFAULT_NUM_AGENTS=20
DEFAULT_NUM_ROUNDS=3
TEMPERATURE=0.7
